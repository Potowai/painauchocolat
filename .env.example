# Variables d'environnement — copier en .env.local et compléter.
# NE JAMAIS committer le fichier .env réel.

# Nom du cloud Cloudinary (dashboard Cloudinary)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Identifiants API Cloudinary (dashboard > API Keys)
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Dossier de destination des images
CLOUDINARY_FOLDER=your_folder
